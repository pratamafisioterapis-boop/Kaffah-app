# Supabase Configuration
# Required for connecting to your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Drive Integration (if using Google features)
VITE_GOOGLE_API_KEY=your-google-api-key

# AI Saran Klinis (RAG jurnal fisioterapi via full-text search Postgres,
# gratis) — ini BUKAN env var frontend, set sebagai Supabase Edge Function
# secret (Project Settings > Edge Functions > Secrets), dipakai oleh
# supabase/functions/soap-clinical-advice:
#   ANTHROPIC_API_KEY=...   (sudah dipakai fungsi lain di project ini)

# Notifikasi Email (via Resend, gratis 100 email/hari) — ini BUKAN env var
# frontend, set sebagai Supabase Edge Function secret (Project Settings >
# Edge Functions > Secrets), dipakai oleh supabase/functions/send-email-notification:
#   RESEND_API_KEY=...        (dari resend.com/api-keys)
#   RESEND_FROM_EMAIL=...     (opsional, mis. "Kaffah App <notifikasi@domainanda.com>".
#                              Domain HARUS diverifikasi di Resend (SPF+DKIM) supaya
#                              email tidak masuk folder spam. Tanpa ini, default pakai
#                              domain sandbox onboarding@resend.dev yang cuma bisa
#                              kirim ke alamat email pemilik akun Resend.)
#   APP_URL=...               (opsional, base URL app untuk link di email, mis.
#                              https://app.kaffah.tech)