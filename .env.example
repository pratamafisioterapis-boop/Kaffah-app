# Supabase Configuration
# Required for connecting to your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Google Drive Integration (if using Google features)
VITE_GOOGLE_API_KEY=your-google-api-key

# AI Saran Klinis (RAG jurnal fisioterapi) — ini BUKAN env var frontend,
# set sebagai Supabase Edge Function secrets (Project Settings > Edge
# Functions > Secrets), dipakai oleh supabase/functions/ingest-journal-document
# dan supabase/functions/soap-clinical-advice:
#   ANTHROPIC_API_KEY=...   (sudah dipakai fungsi lain di project ini)
#   VOYAGE_API_KEY=...      (embedding multilingual, https://voyageai.com)