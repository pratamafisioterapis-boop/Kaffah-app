{
  "rewrites": [
    {
      "source": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "clinara.id"
        }
      ],
      "destination": "/clinara-icon.png"
    },
    {
      "source": "/favicon-48.png",
      "has": [
        {
          "type": "host",
          "value": "clinara.id"
        }
      ],
      "destination": "/clinara-icon.png"
    },
    {
      "source": "/logo192.png",
      "has": [
        {
          "type": "host",
          "value": "clinara.id"
        }
      ],
      "destination": "/clinara-icon-app.png"
    },
    {
      "source": "/logo512.png",
      "has": [
        {
          "type": "host",
          "value": "clinara.id"
        }
      ],
      "destination": "/clinara-icon-app.png"
    },
    {
      "source": "/favicon.ico",
      "has": [
        {
          "type": "host",
          "value": "www.clinara.id"
        }
      ],
      "destination": "/clinara-icon.png"
    },
    {
      "source": "/favicon-48.png",
      "has": [
        {
          "type": "host",
          "value": "www.clinara.id"
        }
      ],
      "destination": "/clinara-icon.png"
    },
    {
      "source": "/logo192.png",
      "has": [
        {
          "type": "host",
          "value": "www.clinara.id"
        }
      ],
      "destination": "/clinara-icon-app.png"
    },
    {
      "source": "/logo512.png",
      "has": [
        {
          "type": "host",
          "value": "www.clinara.id"
        }
      ],
      "destination": "/clinara-icon-app.png"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "clinara.id"
        }
      ],
      "destination": "/index-clinara.html"
    },
    {
      "source": "/((?!assets/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.clinara.id"
        }
      ],
      "destination": "/index-clinara.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!assets/).*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        }
      ]
    }
  ]
}
